# Copied to .env by install.sh. Edit, then: sudo ./update.sh
# Image tag to run: latest (default) or a release, v<YYYY.MM.DD.N>, e.g. VERSION=v2026.10.13.1
#VERSION=
TABLE_NAME=Game Table
# Key for the board control API; install.sh generates one. Keep it on this machine.
TABLE_KEY=
CLOUD_URL=https://games.skylar.technology
# Production: no new games while the service is unreachable (running games pause).
REQUIRE_CLOUD=1
PORT=8080
# Leave empty to use this PC's LAN address in the QR code, or set e.g. http://192.168.1.50:8080
PUBLIC_URL=
SHOW_TEST_GAMES=0
GRACE_MS=60000
AI_DELAY_MS=800
# Remote play (phase 1c): how many remote players may take a seat.
MAX_REMOTE_PLAYERS=4
