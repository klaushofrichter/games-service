[Unit]
Description=Game Table board (kiosk browser)
After=docker.service network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=table
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_RUNTIME_DIR=/run/user/%U
# cage: a minimal Wayland compositor that runs one full-screen app; no desktop, no screen blanking.
ExecStart=/usr/bin/cage -d -- /opt/gametable/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
