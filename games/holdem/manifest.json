{
  "id": "holdem",
  "name": "Hold'em",
  "version": "2026.10.17.2",
  "sdk": "^0.1",
  "description": "Fixed-limit Texas Hold'em. Your two cards stay on your phone; the board shows the shared cards and the pot. Points only.",
  "players": {
    "min": 2,
    "max": 8
  },
  "turnModel": "sequential",
  "seatLayouts": [
    2,
    4,
    6,
    8
  ],
  "edges": [
    "north",
    "south",
    "east",
    "west"
  ],
  "seatConstraints": null,
  "dynamicPlayers": false,
  "saveGame": true,
  "settings": [
    {
      "key": "startPoints",
      "type": "int",
      "min": 100,
      "max": 100000,
      "default": 500,
      "label": "Starting points"
    },
    {
      "key": "smallBet",
      "type": "int",
      "min": 2,
      "max": 1000,
      "default": 10,
      "label": "Small bet (big blind)"
    },
    {
      "key": "hands",
      "type": "int",
      "min": 1,
      "max": 200,
      "default": 20,
      "label": "Hands to play"
    },
    {
      "key": "turnSeconds",
      "type": "int",
      "min": 0,
      "max": 120,
      "default": 30,
      "label": "Seconds per decision (0 = no limit)"
    },
    {
      "key": "showdownSeconds",
      "type": "int",
      "min": 2,
      "max": 30,
      "default": 8,
      "label": "Seconds to show each result"
    }
  ],
  "ai": {
    "supported": true,
    "options": [
      {
        "key": "style",
        "type": "enum",
        "values": [
          "tight",
          "loose"
        ],
        "default": "tight",
        "label": "Play style"
      }
    ],
    "hostConfig": []
  },
  "simulation": {
    "supported": true,
    "headless": true
  },
  "remoteBoardControl": true,
  "skipTimers": [
    "next"
  ],
  "lobbyButton": "bottom-right",
  "deck": {
    "minWidth": 320,
    "orientation": "portrait"
  },
  "permissions": []
}
