{
  "id": "coin-flip",
  "name": "Coin Flip",
  "version": "2026.10.17.1",
  "sdk": "^0.1",
  "description": "Everyone guesses heads or tails, then the coin flips. Most correct guesses wins.",
  "players": {
    "min": 1,
    "max": 8
  },
  "turnModel": "simultaneous",
  "seatLayouts": [
    2,
    4,
    6,
    8
  ],
  "edges": [
    "north",
    "south",
    "east",
    "west"
  ],
  "seatConstraints": null,
  "dynamicPlayers": true,
  "saveGame": false,
  "settings": [
    {
      "key": "rounds",
      "type": "int",
      "min": 1,
      "max": 20,
      "default": 3,
      "label": "Rounds"
    },
    {
      "key": "roundSeconds",
      "type": "int",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 15,
      "label": "Seconds to guess (0 = no limit)"
    }
  ],
  "ai": {
    "supported": true,
    "options": [],
    "hostConfig": []
  },
  "simulation": {
    "supported": true,
    "headless": true
  },
  "remoteBoardControl": true,
  "lobbyButton": "bottom-right",
  "viewer": {
    "columns": [
      { "key": "round", "label": "Round" },
      { "key": "guess", "label": "Guess" },
      { "key": "coin", "label": "Coin" },
      { "key": "score", "label": "Score" }
    ]
  },
  "permissions": []
}
