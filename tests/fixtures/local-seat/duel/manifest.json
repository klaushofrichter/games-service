{
  "id": "duel",
  "name": "Duel",
  "version": "1.0.0",
  "sdk": "^0.1",
  "description": "Test game for localSeat (D-128b) and the board's settings window (D-129b): two players, the one at the table sits south; a setting with five choices and one with two. AI options with long labels, like Chess's, for the settings' players rows (D-226). Played from all four edges (facing: any, D-227). Pace: {pace} (a setting in the description, D-238). A seed that applies only to a random board (D-245).\n\n{side.hint}",
  "players": [
    2
  ],
  "turnModel": "sequential",
  "seatLayouts": [
    2
  ],
  "edges": [
    "north",
    "south"
  ],
  "localSeat": "south",
  "ai": {
    "supported": true,
    "options": [
      {
        "key": "engine",
        "type": "enum",
        "values": [
          "own engine",
          "online engine"
        ],
        "default": "own engine",
        "label": "Engine (online ones fall back to the own engine)",
        "random": true
      },
      {
        "key": "strength",
        "type": "enum",
        "values": [
          "800",
          "1200",
          "1600",
          "2000",
          "2400"
        ],
        "default": "1600",
        "label": "Strength (Elo, approximate)"
      }
    ]
  },
  "test": true,
  "settings": [
    {
      "key": "pace",
      "type": "enum",
      "values": [
        "no limit",
        "very slow",
        "slow",
        "quick",
        "very quick"
      ],
      "default": "no limit",
      "label": "Pace of play"
    },
    {
      "key": "side",
      "type": "enum",
      "values": [
        "left",
        "right"
      ],
      "default": "left",
      "label": "Side",
      "hints": {
        "left": "Left: the first move is yours (D-249).",
        "right": "Right: the other player moves first (D-249)."
      }
    },
    {
      "key": "board",
      "type": "enum",
      "values": [
        "fixed",
        "random"
      ],
      "default": "fixed",
      "label": "Board",
      "hints": {
        "fixed": "The same board every game.",
        "random": "A new board from a seed."
      },
      "labels": {
        "fixed": "Fixed",
        "random": "Random"
      }
    },
    {
      "key": "seed",
      "type": "int",
      "min": 0,
      "max": 999999,
      "default": 0,
      "label": "Board's seed",
      "when": {
        "board": "random"
      },
      "random": true
    },
    {
      "key": "motto",
      "type": "string",
      "max": 20,
      "default": "Good luck",
      "label": "Table motto"
    }
  ],
  "facing": "any"
}
